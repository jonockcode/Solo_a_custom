<form class="cr-newsletter-form" method="post" action="https://flow.cleverreach.com/fl/bf1c06ee-3706-4e6d-a8b8-be96947f5f2c/confirm" target="_blank" rel="noopener" aria-label="Newsletter">
    <input type="text" name="email_confirm" class="cr-newsletter-honeypot" tabindex="-1" autocomplete="off" aria-hidden="true">

    <div class="cr-newsletter-names">
        <div class="cr-newsletter-field">
            <label for="newsletter-first-name">Vorname *</label>
            <input id="newsletter-first-name" type="text" name="global.name" maxlength="255" autocomplete="given-name" required>
        </div>
        <div class="cr-newsletter-field">
            <label for="newsletter-last-name">Nachname *</label>
            <input id="newsletter-last-name" type="text" name="global.nachname" maxlength="255" autocomplete="family-name" required>
        </div>
    </div>

    <div class="cr-newsletter-field">
        <label for="newsletter-postcode">Postleitzahl *</label>
        <input id="newsletter-postcode" type="text" name="global.plz" maxlength="255" inputmode="numeric" autocomplete="postal-code" required>
    </div>

    <div class="cr-newsletter-field">
        <label for="newsletter-email">E-Mail *</label>
        <input id="newsletter-email" type="email" name="email" autocomplete="email" required>
    </div>

    <button class="gh-btn gh-primary-btn" type="submit">Anmelden</button>
</form>
